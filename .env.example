NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API (para IA y generación de imágenes)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key

# DeepSeek V4 — proveedor de TEXTO (recetas, menús, listas, chat). Más barato.
# Si se setea DEEPSEEK_API_KEY, la generación de texto usa DeepSeek con fallback
# automático a Gemini. La visión e imágenes siguen en Gemini.
DEEPSEEK_API_KEY=
# AI_TEXT_PROVIDER=deepseek        # "deepseek" | "gemini" (default: deepseek si hay key)
# AI_CHAT_PROVIDER=deepseek        # override del proveedor solo para el chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_TEXT=deepseek-v4-flash   # override PRIMARIO del modelo de texto
# (deepseek-v4-pro es de reasoning: ~60s y trunca JSON; no usar para rutas con maxDuration 30)

# (Opcional) Override de modelos Gemini. Los defaults de texto/visión/pro son
# válidos (gemini-3.5-flash GA, gemini-2.5-flash-image, gemini-2.5-pro).
# OJO: el default de IMAGE_GEN (imagen-3.0-generate-002) está RETIRADO; las
# rutas de imagen caen a FLASH_IMAGE por try/catch, pero conviene apuntarlo a un
# modelo vigente (familia Nano Banana) o quitar el paso Imagen 3.
# GEMINI_MODEL_FLASH=gemini-3.5-flash
# GEMINI_MODEL_FLASH_IMAGE=gemini-2.5-flash-image
# GEMINI_MODEL_PRO=gemini-2.5-pro
# GEMINI_MODEL_IMAGE_GEN=imagen-3.0-generate-002

# Pexels API (gratis, 200 req/hora) - fotos reales de comida para recetas
# Obtener en: https://www.pexels.com/api/new/
# Sin esta key el sistema cae directamente a Imagen 3 (comportamiento anterior)
PEXELS_API_KEY=

# Analytics - PostHog (opcional, sin esto el tracking solo logueará en consola)
# Obtén tu API key gratis en https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Spoonacular API (fallback para búsqueda de recetas externas)
# Plan gratis: 150 requests/día. Sin esta key el endpoint retorna 503 con instrucciones.
# Obtener en: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# Cron jobs (Vercel): secreto que autentica /api/cron/* y /api/push/send.
CRON_SECRET=

# Push notifications (Web Push / VAPID). Sin NEXT_PUBLIC_VAPID_PUBLIC_KEY el
# registro de suscripciones falla. Generar par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# URL pública de la app (usada por rutas server para construir enlaces absolutos).
NEXT_PUBLIC_APP_URL=http://localhost:3000
